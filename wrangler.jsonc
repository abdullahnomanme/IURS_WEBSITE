{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "iurs",
  "main": "src/index.js",
  "compatibility_date": "2026-08-19",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "iurs-production",
      "database_id": "5880d1f4-b275-4ca0-b5db-ed33abb0dd09",
      "migrations_dir": "db/migrations"
    }
  ]
}
