{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Must stay "iurs-website": that is the Worker the GitHub repository is connected
  // to in the Cloudflare dashboard, and Workers Builds refuses to publish under any
  // other name. Renaming it here silently creates a second, domain-less Worker.
  "name": "iurs-website",
  "main": "src/index.js",
  "compatibility_date": "2026-08-19",
  // The society's own domain. Both of these are Cloudflare "custom domains", so
  // Cloudflare creates and keeps the DNS records itself — there is nothing to add
  // by hand. They only start answering once iurs.org.bd's nameservers at the
  // registrar are switched to the two Cloudflare gave you; until then the site
  // stays reachable on iurs.abdullahnoman-me.workers.dev, which keeps working
  // afterwards too.
  "routes": [
    { "pattern": "iurs.org.bd", "custom_domain": true },
    { "pattern": "www.iurs.org.bd", "custom_domain": true }
  ],
  // Declaring "routes" turns the free iurs.abdullahnoman-me.workers.dev address
  // OFF by default, which would take the site offline for as long as the domain's
  // nameservers are still switching over. Keep it on: it costs nothing and it is
  // the address that works today.
  "workers_dev": true,
  "preview_urls": true,
  // "run_worker_first": true sends every request through src/index.js first.
  // This is required so the site can add security headers, serve /robots.txt
  // and /sitemap.xml, fill in the real website address for search engines, and
  // serve uploaded photos. Static files are still served from ./public.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "iurs-production",
      "database_id": "4a79ce98-329c-4838-b162-f94a42fe165a",
      "migrations_dir": "db/migrations"
    }
  ],
  // Photo uploads from the admin dashboard are stored in R2 (Cloudflare's file
  // storage) when it is available. R2 is OFF by default on new accounts, and a
  // Worker cannot be published while it points at an R2 bucket that is not
  // enabled, so the binding below is deactivated on purpose.
  //
  // Drag-and-drop upload works either way. With the binding off, a file is kept
  // in D1 instead (the media_blobs table) and served from the same /uploads/...
  // address, so nothing about the pages changes. The only difference is size: a
  // single file has to stay under ~900 KB without R2 versus 8 MB with it, and the
  // dashboard shrinks pictures in the browser first so ordinary photos fit.
  //
  // deploy.ps1 turns this on for you AUTOMATICALLY the moment R2 is enabled on
  // your account — you do not need to edit this file. Files already uploaded to
  // D1 keep being served after the switch. (If you deploy through the
  // GitHub/Workers Builds route instead, enable R2 in the Cloudflare dashboard
  // and delete the two // marks in front of the three "r2_buckets" lines below.)
  //
  // "r2_buckets": [
  //   { "binding": "MEDIA", "bucket_name": "iurs-media" }
  // ],
  // Powers the website assistant (the chat bubble). It is answered from your own
  // database first, and the model may only rephrase those facts. If this binding
  // is ever removed the assistant keeps working and simply quotes the database
  // directly, so the chat never invents anything about IURS.
  "ai": {
    "binding": "AI"
  }
}
