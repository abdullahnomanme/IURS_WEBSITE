{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "iurs-website",
  "main": "src/index.js",
  "compatibility_date": "2026-08-19",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "iurs-production",
      "database_id": "4a79ce98-329c-4838-b162-f94a42fe165a",
      "migrations_dir": "db/migrations"
    }
  ]
}
